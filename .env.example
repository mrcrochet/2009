# --- Supabase (optional in local dev; the game is fully playable without it) ---
NEXT_PUBLIC_SUPABASE_URL=
# The current key format. NEXT_PUBLIC_SUPABASE_ANON_KEY is still read as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, read by lib/supabase/admin.ts. Never reaches the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (optional in local dev; paywall degrades to a "not configured" state) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price ids come from config/env, never hardcoded in components.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# --- Analytics (thin adapter; noop when unset) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Set to 1 to make analytics opt-in: nothing is sent and no id is minted until consent is
# granted. Leave unset outside jurisdictions that require it.
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=

# --- Errors (thin adapter; console when unset) ---
NEXT_PUBLIC_SENTRY_DSN=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
